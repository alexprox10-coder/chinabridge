{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/import-leads/run",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/ai-cto",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/content-publish",
      "schedule": "0 * * * *"
    }
  ]
}
